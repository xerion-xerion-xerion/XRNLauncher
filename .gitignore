# ==========================================================
#  Ne jamais publier de donnees personnelles ni d'etat local
# ==========================================================

# Configuration propre a chaque machine
config.local.json
*.local.json
launcher/config.local.json
launcher/*.local.json

# Scripts de travail jetables (correctifs, audits, mesures)
_*.*

# Ce que le launcher ecrit a l'execution : comptes, journaux,
# jetons, sessions
profiles.json
accounts.json
*.log
logs/
*.log.*

# Dossier du jeu : monde, mods, reglages, captures, sauvegardes
minecraft/
saves/
mods/
resourcepacks/
shaderpacks/
screenshots/
backups/
crash-reports/
options.txt
servers.dat
usercache.json
launcher_profiles.json
*.mca
level.dat*
knownkeys.json

# Java installe par le launcher
/java/
/launcher/java/
jdk*/

# Secrets
*.pem
*.key
.env
.env.*
token*.txt

# Builds et archives
build/
dist/
*.zip
!launcher/lib/assets/*.jar

# Le site est a la racine du depot : la copie de travail qui se trouve
# dans launcher/site/ n a rien a y etre.
launcher/site/

# Systeme
Thumbs.db
desktop.ini
.DS_Store
node_modules/
# Native runtime and local build products
*.dll
*.pak
*.bin
release/
installer-fixture/
installer/payload.iss
installer/payload.json
**/unins*
**/.gradle/
*.exe
!launcher/tools/XrnMedia.exe
