  "authors": [
    "Xerion"
  ],
  "license": "MIT",
  "environment": "client",
  "mixins": [
    {
      "config": "xrnhud.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "client": [
      "fr.xerion.xrnhud.XrnHudClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
